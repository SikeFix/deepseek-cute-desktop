{
  "name": "deepseek-cute-desktop-windows",
  "version": "1.4.1",
  "description": "DeepSeek Harness themed Windows desktop app with a task-aware desktop pet",
  "main": "main.js",
  "author": "sikefix",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.sikefix.deepseek.cute.windows",
    "productName": "DeepSeek Cute",
    "artifactName": "DeepSeek-Cute-Windows-x64-Setup-${version}.${ext}",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pet-preload.js",
      "window-inject.js",
      "waiting.html",
      "pet.html",
      "scripts/after-pack.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "theme",
        "to": "theme"
      },
      {
        "from": "runtime/node",
        "to": "runtime/node"
      },
      {
        "from": "runtime/node_modules",
        "to": "runtime/dsh/node_modules"
      },
      {
        "from": "runtime/licenses",
        "to": "runtime/licenses"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Cute",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SikeFix",
        "repo": "deepseek-cute-desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9"
  }
}
